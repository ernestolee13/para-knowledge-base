{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ernestolee13/para-knowledge-base/contracts/vault-config-v1.schema.json",
  "title": "PARA Knowledge Base vault configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "para_roots",
    "index_file_names",
    "spine_paths",
    "telemetry",
    "privacy",
    "exclusions",
    "consumer_profile"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "para_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["common", "projects", "areas", "resources", "archive"],
      "properties": {
        "common": { "$ref": "#/$defs/relativeDirectory" },
        "projects": { "$ref": "#/$defs/relativeDirectory" },
        "areas": { "$ref": "#/$defs/relativeDirectory" },
        "resources": { "$ref": "#/$defs/relativeDirectory" },
        "archive": { "$ref": "#/$defs/relativeDirectory" },
        "inbox": { "$ref": "#/$defs/relativeDirectory" }
      }
    },
    "index_file_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^/\\\\]+\\.md$" }
    },
    "spine_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "active_path", "archive_dir", "max_bytes", "max_archives"],
      "properties": {
        "enabled": { "type": "boolean" },
        "active_path": { "$ref": "#/$defs/relativePath" },
        "archive_dir": { "$ref": "#/$defs/relativePath" },
        "max_bytes": { "type": "integer", "minimum": 65536, "maximum": 104857600 },
        "max_archives": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "paths"],
      "properties": {
        "content": { "const": "never" },
        "paths": { "const": "vault-relative" }
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "consumer_profile": { "const": "para-kb-v1" },
    "schedules": {
      "type": "array",
      "description": "Recurring KB tasks, managed by scripts/para_kb_schedule.py. Run state lives in .para-kb/state/, not here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
          "task": { "enum": ["kb-dream", "kb-lint", "kb-index"] },
          "cadence": { "enum": ["daily", "weekly", "monthly"] },
          "weekday": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
          "day": { "type": "integer", "minimum": 1, "maximum": 28 },
          "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
          "runner": { "enum": ["claude", "codex", "command"] },
          "runner_path": { "type": "string" },
          "model": { "type": "string" },
          "command": { "type": "string", "description": "runner=command: template with {prompt_file}, {vault}, {id}, {model}" },
          "claude_args": { "type": "array", "items": { "type": "string" } },
          "prompt_extra": { "type": "string" },
          "timeout_minutes": { "type": "integer", "minimum": 1, "maximum": 240 },
          "grace_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
          "retry_minutes": { "type": "integer", "minimum": 0, "maximum": 10080 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "dream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_fix": { "enum": ["mechanical", "none"] },
        "report_dir": { "$ref": "#/$defs/relativePath" },
        "max_targets": { "type": "integer", "minimum": 1, "maximum": 500 },
        "lookback_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "promote": { "type": "boolean", "description": "Propose promotion and demotion between layers. Turn off when another job already owns that." },
        "skip_paths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "extra_note_dirs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "mode": { "enum": ["propose", "fix"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relativeDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+/$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
