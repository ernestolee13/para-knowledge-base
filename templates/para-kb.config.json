{
  "schema_version": 1,
  "para_roots": {
    "common": "0. Common/",
    "projects": "1. Projects/",
    "areas": "2. Areas/",
    "resources": "3. Resources/",
    "archive": "4. Archive/",
    "inbox": "Inbox/"
  },
  "index_file_names": ["index.md", "_index.md"],
  "spine_paths": ["CLAUDE.md", "AGENTS.md", "0. Common/index.md", "0. Common/log.md"],
  "telemetry": {
    "enabled": true,
    "active_path": "0. Common/query-telemetry.jsonl",
    "archive_dir": "0. Common/telemetry-archive",
    "max_bytes": 5242880,
    "max_archives": 4
  },
  "privacy": {
    "content": "never",
    "paths": "vault-relative"
  },
  "exclusions": [".para-kb/", "$CONFIG_DIR/", ".trash/"],
  "consumer_profile": "para-kb-v1"
}
